    "ingestao": "tsx pipeline/ingestao-cli.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/react": "^14.3.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "3.4.2",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vite": "^5.4.21",
    "vitest": "2.1.8",
    "vitest-axe": "^0.1.0"
  }
